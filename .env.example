# Portal Praktik Poliwako - Environment Variables Example
# PRD Reference: Section 72, 80, 83

# Supabase Project URL & Anonymous Public Key
# Didapatkan dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Database Direct Connection URL (Hanya diperlukan untuk Drizzle Studio / Migrations)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
